generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// Cloudflare D1 (SQLite). At runtime the client connects through
// @prisma/adapter-d1 with the DB binding; this url is only used by the
// Prisma CLI for generating migration SQL locally.
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

// Required by @shopify/shopify-app-session-storage-prisma
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

// A receiving session: one physical "receiving event" (e.g. unpacking a shipment).
// Lines accumulate as barcodes are scanned; committing applies all quantity
// deltas to Shopify inventory in a single inventoryAdjustQuantities call.
model ReceivingSession {
  id          String          @id @default(cuid())
  shop        String
  name        String
  status      String          @default("open") // open | committed
  locationId  String?
  createdAt   DateTime        @default(now())
  committedAt DateTime?
  lines       ReceivingLine[]
  unmatched   UnmatchedScan[]

  @@index([shop, status])
}

// A scanned barcode that matched no variant in the store. Kept on the session
// as an exception list so discrepancies survive past the scan moment and can
// be resolved (wrong barcode in Shopify, product never entered, mispick from
// the supplier) after the shipment is put away.
model UnmatchedScan {
  id             String           @id @default(cuid())
  sessionId      String
  session        ReceivingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  barcode        String
  count          Int              @default(1)
  firstScannedAt DateTime         @default(now())
  lastScannedAt  DateTime         @updatedAt

  @@unique([sessionId, barcode])
  @@index([sessionId])
}

model ReceivingLine {
  id              String           @id @default(cuid())
  sessionId       String
  session         ReceivingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  barcode         String
  variantId       String // gid://shopify/ProductVariant/...
  productId       String // gid://shopify/Product/...
  inventoryItemId String // gid://shopify/InventoryItem/...
  productTitle    String
  variantTitle    String?
  sku             String?
  quantity        Int              @default(1)
  // Money kept as decimal strings (Shopify's Money format) — the app only does
  // arithmetic through services/margin.ts, and D1/SQLite has no decimal type.
  unitCost        String? // cost per item at scan time (null if not set in Shopify)
  originalPrice   String // price at scan time
  currentPrice    String // price after any margin adjustment in this session
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([sessionId, variantId])
  @@index([sessionId])
}
