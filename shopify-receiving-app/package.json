{
  "name": "shopify-receiving-app",
  "private": true,
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy:shopify": "shopify app deploy",
    "deploy": "npm run build && wrangler deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "wrangler dev",
    "setup": "prisma generate && wrangler d1 migrations apply DB --local",
    "shopify": "shopify",
    "prisma": "prisma",
    "wrangler": "wrangler",
    "vite": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.2.1",
    "@prisma/client": "^6.2.1",
    "@remix-run/cloudflare": "^2.16.1",
    "@remix-run/dev": "^2.16.1",
    "@remix-run/fs-routes": "^2.16.1",
    "@remix-run/react": "^2.16.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.0",
    "@shopify/shopify-app-remix": "^3.7.0",
    "@shopify/shopify-app-session-storage-prisma": "^6.0.0",
    "isbot": "^5.1.0",
    "prisma": "^6.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@remix-run/route-config": "^2.16.1",
    "@types/node": "^22.2.0",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "typescript": "^5.2.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.0",
    "wrangler": "^3.101.0"
  },
  "workspaces": [
    "extensions/*"
  ]
}
